# /etc/neurodeck-config/env — окружение nd-config.service.
# Создаётся deploy.sh (mode 600) при первой установке; в репо — только этот пример.
# После правок: systemctl restart nd-config.service

# Токен приёма телеметрии (openssl rand -hex 24). Пустой/короткий (<16) = приёмник
# считается выключенным независимо от флага ниже (fail-safe).
ND_CONFIG_TOKEN=

# Opt-in телеметрия: DEFAULT OFF. «1» включает POST /v1/telemetry (требует токен выше).
# Клиентский экспорт тоже выключен по умолчанию — включение не рассылает ничего само по себе.
ND_TELEMETRY_ENABLED=0

# Слушать только localhost. Не менять без решения владельца: наружу сервис не выставляется.
ND_CONFIG_HOST=127.0.0.1
ND_CONFIG_PORT=8095

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: explicit secret token for /api/register-user defense in depth.
# If omitted, derived from TELEGRAM_BOT_TOKEN (still secure but not rotation-friendly).
SECRET_TOKEN=

# Required: frontend origin allowed to call this API (CORS).
# For local dev: http://localhost:8080 or *
# For production: https://serwaksus.github.io
ALLOWED_ORIGIN=https://serwaksus.github.io

# Optional: port (default 3000)
PORT=3000

# Optional: persistent DB path (default ./data/db.json relative to app root).
# In Docker, this is the mounted volume target.
DB_PATH=/app/data/db.json
